def write_cask(repo, out, ordered, version, base):
    """Fill packaging/homebrew/Casks/less-sheet.rb from THIS run's real digest.

    The digest is the one thing in a cask that cannot be checked by the person
    writing it: a wrong sha256 still installs fine for the author, whose
    Homebrew already has the file cached, and fails for every later user with an
    error that reads like a corrupted download. So it is copied from
    SHA256SUMS mechanically and never typed.
    """
    tpl = os.path.join(repo, "packaging", "homebrew", "Casks", "less-sheet.rb")
    if not os.path.isfile(tpl):
        return None
    zips = [a for a in ordered if a["file"].endswith(".zip") and "macos" in a["file"]]
    if not zips:
        return None
    with open(tpl) as fh:
        body = fh.read()
    body = (body.replace('version "VERSION"', 'version "%s"' % version)
                .replace('sha256 "SHA256"', 'sha256 "%s"' % zips[0]["sha256"])
                .replace("DOWNLOAD_BASE", base.rstrip("/")))
    # HOMEPAGE is deliberately NOT guessed from the download URL — a release
    # base and a project page are not reliably the same host, and a cask that
    # points somewhere plausible-but-wrong is worse than one that visibly still
    # needs a value.
    cpath = os.path.join(out, "less-sheet.rb")
    with open(cpath, "w") as fh:
        fh.write(body)
    if "HOMEPAGE" in body:
        print("  note: the cask still has HOMEPAGE unset — fill it before pushing")
    return cpath


def main():
    ap = argparse.ArgumentParser(
        description="Build, verify and checksum the downloadable less-sheet artifacts.")
    ap.add_argument("--platform", choices=("mac", "linux", "all"), default="all")
    ap.add_argument("--arch", choices=("aarch64", "x86_64", "both"), default="both",
                    help="Linux architectures (default both; x86_64 is emulated on ARM hosts)")
    ap.add_argument("--mac-format", choices=("zip", "dmg", "tgz", "all"), default="all")
    ap.add_argument("--cask-base", metavar="URL",
                    help="release download base URL; writes dist/less-sheet.rb "
                         "with this run's real version and sha256 filled in")
    ap.add_argument("--out", default=None, help="output directory (default <repo>/dist)")
    ap.add_argument("--version", default=None, help="override the version string")
    ap.add_argument("--skip-verify", action="store_true",
                    help="package without running the artifacts (NOT recommended)")
    args = ap.parse_args()

    repo = find_repo()
    check_legal(repo)
    zig = check_zig()
    out = args.out or os.path.join(repo, "dist")
    version, vwarn = resolve_version(repo, args.version)
    do_verify = not args.skip_verify
    notes = []
    if vwarn:
        notes.append(vwarn)

    print("less-sheet release build")
    print("  repo    %s" % repo)
    print("  version %s" % version)
    print("  zig     %s" % zig)
    print("  out     %s" % out)
    print("  verify  %s" % ("run each artifact" if do_verify else "DISABLED"))
    print()

    arts = []
    if args.platform in ("mac", "all"):
        formats = ("zip", "tgz", "dmg") if args.mac_format == "all" else (args.mac_format,)
        arts += build_macos(repo, out, version, do_verify, formats, notes)
    if args.platform in ("linux", "all"):
        arches = ("aarch64", "x86_64") if args.arch == "both" else (args.arch,)
        arts += build_linux(repo, out, version, arches, do_verify, notes)

    if not arts:
        die("no artifacts were produced")

    os.makedirs(out, exist_ok=True)
    ordered, carried = merge_outputs(out, arts, version, notes)

    print("\n%-44s %9s  %s" % ("ARTIFACT", "SIZE", "RUNS?"))
    for a in ordered:
        run_note = a["verified_by_running"] or "not verified"
        if a["file"] in carried:
            run_note = "(from an earlier run) " + run_note
        print("%-44s %8.1fM  %s" % (a["file"], a["bytes"] / 1048576.0, run_note))
    print("\nwrote %s/SHA256SUMS and %s/manifest.json" % (out, out))
    if getattr(args, "cask_base", None):
        cpath = write_cask(repo, out, ordered, version, args.cask_base)
        if cpath:
            print("wrote %s (paste into your homebrew-tap; see "
                  "packaging/homebrew/README.md)" % cpath)
        else:
            print("no .zip artifact in this run, so no cask was written "
                  "(the cask installs the zip)")
    if notes:
        print("\nNOTES / THINGS THAT NEED A DECISION:")
        for n in notes:
            print("  - " + n)
    print("\nNothing has been published. Uploading these is a separate, deliberate "
          "step (docs/RELEASE.md).")


if __name__ == "__main__":
    main()

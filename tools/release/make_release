def build_macos(repo, out, version, do_verify, formats, notes):
    if sys.platform != "darwin":
        notes.append("macOS artifacts skipped: not running on macOS")
        return []
    if not shutil.which("swift"):
        die("swift not found; the Swift 6 toolchain is required for the macOS app")

    print("[mac  ] assembling the .app (ReleaseSafe core + relink + bundle seal) ...", flush=True)
    must(["bash", os.path.join(repo, "apps", "macos", "scripts", "assemble-app.sh")],
         "assemble-app.sh")

    app = os.path.join(repo, "apps", "macos", ".build", "arm64-apple-macosx",
                       "release", "less-sheet.app")
    if not os.path.isdir(app):
        die("assemble-app.sh reported success but %s is missing" % app)
    binary = os.path.join(app, "Contents", "MacOS", "LessSheet")

    # --- staleness guard -------------------------------------------------
    # SwiftPM does not track liblesssheet.a as a build input, so a successful
    # build is NOT evidence that the shipped binary contains the current core.
    # assemble-app.sh force-drops the link product; this re-checks the outcome
    # by mtime ordering: binary newer than the archive, archive newer than the
    # newest backend source.
    core_a = os.path.join(repo, "backend", "zig-out", "lib", "liblesssheet.a")
    if not os.path.isfile(core_a):
        die("core archive missing at %s" % core_a)
    src_m = newest_mtime([os.path.join(repo, "backend", "src")], exts=(".zig",))
    if os.path.getmtime(core_a) < src_m:
        die("STALE CORE: liblesssheet.a is older than backend/src/*.zig")
    if os.path.getmtime(binary) < os.path.getmtime(core_a):
        die("STALE LINK: the app binary predates liblesssheet.a (SwiftPM reused a link product)")
    print("[mac  ] freshness OK: backend sources -> core archive -> app binary", flush=True)

    # --- shape of what we are shipping ----------------------------------
    arch = run(["lipo", "-archs", binary]).stdout.split()
    minos = None
    m = re.search(r"minos\s+([0-9.]+)",
                  run(["otool", "-l", binary]).stdout)
    if m:
        minos = m.group(1)
    with open(os.path.join(app, "Contents", "Info.plist"), "rb") as fh:
        pl = plistlib.load(fh)
    ls_min = pl.get("LSMinimumSystemVersion")
    # ASYMMETRIC ON PURPOSE, AND FATAL IN THE DANGEROUS DIRECTION.
    #
    # If Info.plist declares a floor BELOW what the binary actually requires,
    # Finder happily offers the app on that OS and dyld then kills it: the user
    # gets a crash where they should have got "requires macOS N or later". That is
    # a shipped crash, so it must ABORT the release, not append a note. This is a
    # live defect, not a hypothetical — the plist read 15.0 while the binary
    # required 26.0 until 2026-08-05, and it was a note that nobody had to act on.
    #
    # The reverse (a declared floor ABOVE the binary's) only over-restricts: the
    # app refuses to launch somewhere it would have worked. Worth reporting, not
    # worth blocking.
    #
    # Compare full version tuples, not just the major: 26.0 vs 26.1 is exactly the
    # kind of near-miss a major-only test waves through, and it is the same
    # dyld-kill outcome.
    def _ver(s):
        try:
            return tuple(int(p) for p in str(s).split("."))
        except (TypeError, ValueError):
            return None

    mv, lv = _ver(minos), _ver(ls_min)
    if mv and lv:
        if lv < mv:
            die("MIN-OS MISMATCH, refusing to package: the binary requires macOS "
                "%s but Info.plist LSMinimumSystemVersion declares %s. Finder would "
                "offer this app on %s and dyld would then kill it — a crash instead "
                "of a clean 'requires macOS %s or later'. Fix Info.plist (or the "
                "deployment target) so the declared floor is not below the real one."
                % (minos, ls_min, ls_min, minos))
        if lv > mv:
            notes.append("Info.plist declares LSMinimumSystemVersion %s while the "
                         "binary only requires %s - not a crash, but the app refuses "
                         "to launch on systems it would run on" % (ls_min, minos))
    elif minos and ls_min and minos != ls_min:
        die("MIN-OS MISMATCH, refusing to package: binary minos %s vs Info.plist "
            "LSMinimumSystemVersion %s, and at least one of them is not a parseable "
            "version so the comparison cannot be trusted" % (minos, ls_min))

    # Non-system dynamic dependencies would have to be bundled + re-signed.
    otool = run(["otool", "-L", binary]).stdout.splitlines()[1:]
    foreign = [l.split()[0] for l in otool
               if l.strip() and not l.strip().startswith(("/usr/lib/", "/System/"))]
    if foreign:
        notes.append("macOS binary links non-system libraries (would need bundling): %s"
                     % ", ".join(foreign))

    seal = run(["codesign", "--verify", "--strict", "--verbose=2", app])
    if seal.returncode != 0:
        die("the assembled bundle is NOT validly sealed:\n" + seal.stderr)
    sig = run(["codesign", "-dv", app]).stderr
    adhoc = "adhoc" in sig
    gk = run(["spctl", "--assess", "-vv", app])
    gatekeeper = "accepted" if gk.returncode == 0 else "rejected"
    verdict = ""
    if shutil.which("syspolicy_check"):
        verdict = run(["syspolicy_check", "distribution", app]).stdout

    if do_verify:
        ok, detail = verify_macos_app(app, "build tree")
        if not ok:
            die("the assembled app failed its headless open check: " + detail)
        print("[mac  ] runs from the build tree: %s" % detail, flush=True)

    arts = []
    os.makedirs(out, exist_ok=True)
    base = "less-sheet-%s-macos-%s" % (version, "-".join(arch) if arch else "unknown")

    if "zip" in formats:
        zpath = os.path.join(out, base + ".zip")
        if os.path.exists(zpath):
            os.remove(zpath)
        # ditto, not zip(1): Apple's archiver round-trips a .app bundle (and its
        # _CodeSignature seal) faithfully. A plain `zip -r` can mangle the bundle.
        must(["ditto", "-c", "-k", "--sequesterRsrc", "--keepParent", app, zpath], "ditto zip")
        arts.append(finish_mac_artifact(zpath, "zip", version, arch, minos, ls_min,
                                        adhoc, gatekeeper, verdict, do_verify, notes))
        merge_outputs(out, arts, version, notes)   # bank it before attempting the dmg

    if "tgz" in formats:
        tpath = os.path.join(out, base + ".tar.gz")
        if os.path.exists(tpath):
            os.remove(tpath)
        # This artifact exists for ONE reason: `curl` does not set
        # com.apple.quarantine, and a browser does. Gatekeeper's first-launch
        # refusal keys on that attribute, NOT on the signature — an ad-hoc
        # signed build that spctl rejects still launches with no prompt when
        # the attribute is absent. So a piped curl|tar install is the only
        # route that is genuinely one step for an unnotarized app.
        #
        # tar, not ditto: `ditto -c -k` writes a zip, and unzipping in a
        # one-liner needs a temp file. tar streams. The bundle survives it —
        # the ad-hoc signature is EMBEDDED in the Mach-O, not carried in an
        # xattr, and the executable bit is preserved (verified below by
        # actually unpacking and re-running the seal check).
        #
        # --no-xattrs + COPYFILE_DISABLE for the same reason as the Linux
        # tarball: macOS tar otherwise stores com.apple.provenance and GNU tar
        # warns once per file about it on the other end.
        tenv = dict(os.environ)
        tenv["COPYFILE_DISABLE"] = "1"
        must(["tar", "--no-xattrs", "-C", os.path.dirname(app), "-czf", tpath,
              os.path.basename(app)], "tar czf", env=tenv)
        arts.append(finish_mac_artifact(tpath, "tgz", version, arch, minos, ls_min,
                                        adhoc, gatekeeper, verdict, do_verify, notes))
        merge_outputs(out, arts, version, notes)

    if "dmg" in formats:
        dpath = os.path.join(out, base + ".dmg")
        if os.path.exists(dpath):
            os.remove(dpath)
        stage = tempfile.mkdtemp(prefix="ls-dmg-")
        try:
            shutil.copytree(app, os.path.join(stage, "less-sheet.app"), symlinks=True)
            # Also visible in the mounted volume, next to the app being dragged.
            # The authoritative copies are inside Contents/Resources (they have
            # to be — a dmg is not installed, only its contents are).
            shutil.copy(os.path.join(repo, "LICENSE"), os.path.join(stage, "LICENSE.txt"))
            must(["hdiutil", "create", "-quiet", "-srcfolder", stage,
                  "-volname", "less-sheet", "-fs", "HFS+",
                  "-format", "UDZO", "-imagekey", "zlib-level=9", dpath], "hdiutil create")
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        arts.append(finish_mac_artifact(dpath, "dmg", version, arch, minos, ls_min,
                                        adhoc, gatekeeper, verdict, do_verify, notes))
    return arts


def finish_mac_artifact(path, kind, version, arch, minos, ls_min, adhoc,
                        gatekeeper, verdict, do_verify, notes):
    """Unpack the artifact, re-verify the seal SURVIVED packaging, and run it."""
    ran = None
    if do_verify:
        tmp = tempfile.mkdtemp(prefix="ls-verify-")
        try:
            if kind == "zip":
                must(["ditto", "-x", "-k", path, tmp], "ditto unzip")
                app = os.path.join(tmp, "less-sheet.app")
            elif kind == "tgz":
                must(["tar", "-xzf", path, "-C", tmp], "tar xzf")
                app = os.path.join(tmp, "less-sheet.app")
            else:
                mnt = os.path.join(tmp, "mnt")
                os.makedirs(mnt)
                must(["hdiutil", "attach", "-quiet", "-nobrowse", "-readonly",
                      "-mountpoint", mnt, path], "hdiutil attach")
                try:
                    app = os.path.join(tmp, "less-sheet.app")
                    shutil.copytree(os.path.join(mnt, "less-sheet.app"), app, symlinks=True)
                finally:
                    run(["hdiutil", "detach", "-quiet", mnt])

            # Order-of-operations check: packaging must not break the seal.
            s = run(["codesign", "--verify", "--strict", "--verbose=2", app])
            if s.returncode != 0:
                die("the %s artifact's bundle seal is INVALID after packaging - "
                    "something wrote into the bundle after codesign:\n%s" % (kind, s.stderr))
            ok, detail = verify_macos_app(app, "unpacked " + kind)
            if not ok:
                die("the packaged %s does not run: %s" % (kind, detail))
            ran = detail
            print("[mac  ] %-3s artifact: seal valid after packaging, and it runs (%s)"
                  % (kind, detail), flush=True)
        finally:
            shutil.rmtree(tmp, ignore_errors=True)

    return {
        "file": os.path.basename(path),
        "platform": "macOS",
        "arch": ", ".join(arch) if arch else "unknown",
        "format": kind,
        "bytes": os.path.getsize(path),
        "sha256": sha256(path),
        "requires": {
            "os": "macOS %s or later" % (minos or "?"),
            "declared_LSMinimumSystemVersion": ls_min,
            "cpu": ", ".join(arch) if arch else "unknown",
            "bundled_dependencies": "none - system frameworks only",
        },
        "signing": {
            "state": "ad-hoc (no Developer ID, not notarized)" if adhoc else "signed",
            "bundle_seal": "valid (codesign --verify --strict)",
            "gatekeeper_spctl": gatekeeper,
            "distributable_without_further_work": False,
        },
        "verified_by_running": ran,
    }


def verify_macos_app(app, label):
    """Launch the app headlessly and require the real 'rows on screen' marker.

    Uses the probe harness the test-suite uses: a clean environment with every
    inherited LESSSHEET_* var stripped, LESSSHEET_DUMP_EXIT=1 to quit after
    first paint, and the file as argv[1]. The marker is only emitted once a
    data-bearing table is actually displayed, so its presence proves a real
    open. Rendering is off-screen, so this triggers no macOS permission dialog.
    """
    binary = os.path.join(app, "Contents", "MacOS", "LessSheet")
    if not os.path.isfile(binary):
        return False, "no executable at Contents/MacOS/LessSheet"
    fixture = None
    try:
        fd, fixture = tempfile.mkstemp(suffix=".csv", prefix="ls-fix-")
        with os.fdopen(fd, "w") as fh:
            fh.write("id,name,city\n1,Ada,Riverside\n2,Alan,Fairview\n3,Grace,Madison\n")
        env = {k: v for k, v in os.environ.items() if not k.startswith("LESSSHEET_")}
        env["LESSSHEET_DUMP_EXIT"] = "1"
        t0 = time.time()
        p = subprocess.run([binary, fixture], capture_output=True, text=True,
                           env=env, timeout=90)
        blob = (p.stderr or "") + (p.stdout or "")
        m = re.search(r"lesssheet\.first_rows_visible_ms=(\d+)", blob)
        if not m:
            tail = blob.strip().splitlines()[-3:]
            return False, ("no first_rows_visible marker from %s (exit %d after %.1fs) %s"
                           % (label, p.returncode, time.time() - t0, tail))
        return True, "first rows visible in %s ms" % m.group(1)
    except subprocess.TimeoutExpired:
        return False, "timed out launching %s" % label
    finally:
        if fixture and os.path.exists(fixture):
            os.remove(fixture)



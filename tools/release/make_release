def die(msg):
    print("error: " + msg, file=sys.stderr)
    sys.exit(1)


def run(cmd, **kw):
    """Run a command, streaming nothing, returning CompletedProcess (never raises)."""
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def must(cmd, what, **kw):
    r = run(cmd, **kw)
    if r.returncode != 0:
        die("%s failed (exit %d)\n%s" % (what, r.returncode, (r.stderr or r.stdout)[-3000:]))
    return r



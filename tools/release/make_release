def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for chunk in iter(lambda: fh.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def container_cmd():
    for c in ("podman", "docker"):
        p = shutil.which(c)
        if p:
            return p
    return None


def check_zig():
    if not shutil.which("zig"):
        die("zig not found; zig 0.16.0 is required to build the core")
    v = run(["zig", "version"]).stdout.strip()
    if v != "0.16.0":
        die("zig 0.16.0 required (the backend gate asserts it), found %s" % v)
    return v


def resolve_version(repo, override):
    """Read the ONE place the version lives, and report anything still lagging.

    `<repo>/VERSION` is the single home (`5ac88d7`); `apps/gtk/VERSION` is a
    symlink to it and meson's `project(version : files('VERSION'))` makes
    `meson.project_version()` the single resolver, reaching main.c as
    -DLSG_VERSION. This function does NOT re-derive a version from a consumer —
    that is what it used to do, reading the macOS plist and gtk's meson.build and
    reporting a disagreement it could not fix.

    It still checks the macOS plist, but only to report a consumer that has not
    been wired to the single source. Since `cb15d2d` the tracked plist carries
    __LESSSHEET_VERSION__ and assemble-app.sh substitutes VERSION into the copy
    it lays down, so THE PLACEHOLDER IS THE WIRED STATE. Warning about it says
    the opposite of the truth, and it did: a release build reported "apps/macos
    has not been wired to it yet" about the very mechanism that had just put
    0.1.0 into the shipped bundle. Only a concrete version that disagrees with
    VERSION is a real lag.
    """
    root_path = os.path.join(repo, "VERSION")
    root_ver = None
    if os.path.isfile(root_path):
        with open(root_path) as fh:
            root_ver = fh.read().strip() or None

    plist_path = os.path.join(repo, "apps", "macos", "Bundle", "Info.plist")
    mac_ver = None
    if os.path.isfile(plist_path):
        with open(plist_path, "rb") as fh:
            mac_ver = plistlib.load(fh).get("CFBundleShortVersionString")
    # Wired, not lagging. Clearing it here also stops the fallback below from
    # ever resolving a "version" of __LESSSHEET_VERSION__ if VERSION goes missing.
    if mac_ver == PLIST_VERSION_PLACEHOLDER:
        mac_ver = None

    warn = None
    if root_ver is None:
        warn = ("%s is missing — it is the single home for the version; "
                "falling back to the macOS plist" % root_path)
    elif mac_ver and mac_ver != root_ver:
        warn = ("macOS Info.plist still hardcodes %s while the single source "
                "(VERSION) says %s — apps/macos has not been wired to it yet "
                "(docs/RELEASE.md 1a item 1)" % (mac_ver, root_ver))
    return (override or root_ver or mac_ver or "0.0.0"), warn


# Legal text is not decoration here. The Linux tarball ships a closed-source
# binary linked against LGPL libraries, and docs/RELEASE.md 4a makes shipping the
# notices half of what keeps that compliant — the other half being that GTK stays
# dynamically linked. A template placeholder reaching a user is the same class of
# bug as a surviving Info.plist version placeholder, so it gets the same guard.
LEGAL_FILES = ("LICENSE", "THIRD-PARTY-NOTICES.md")
# What the TRACKED Info.plist holds; assemble-app.sh substitutes VERSION into
# the bundle copy. Its presence is proof the wiring works, not that it is absent.
PLIST_VERSION_PLACEHOLDER = "__LESSSHEET_VERSION__"
LEGAL_PLACEHOLDER = re.compile(r"<[A-Z][A-Z /]{2,}>")


def check_legal(repo):
    """Both legal files must exist and carry no unfilled <PLACEHOLDER>."""
    for name in LEGAL_FILES:
        path = os.path.join(repo, name)
        if not os.path.isfile(path):
            die("%s is missing at the repo root, and every artifact ships it" % name)
        with open(path) as fh:
            holes = sorted(set(LEGAL_PLACEHOLDER.findall(fh.read())))
        if holes:
            die("%s still carries unfilled placeholders: %s\n"
                "     Fill them in before packaging. A licence template that "
                "reaches a user is worse than no licence at all." % (name, ", ".join(holes)))


def newest_mtime(paths, exts=None):
    newest = 0.0
    for p in paths:
        if os.path.isfile(p):
            newest = max(newest, os.path.getmtime(p))
            continue
        for root, _dirs, files in os.walk(p):
            for f in files:
                if exts and not f.endswith(exts):
                    continue
                newest = max(newest, os.path.getmtime(os.path.join(root, f)))
    return newest



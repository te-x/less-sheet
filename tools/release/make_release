def ensure_build_image(ctr, repo, arch):
    """Return a build image for `arch`, building it from the gate's Dockerfile if absent.

    Uses the gate's own recipe so the release build and the gate agree on the GNOME
    stack, but under an arch-suffixed tag (see GTK_BUILD_IMAGE_FMT).
    """
    image = GTK_BUILD_IMAGE_FMT % arch
    if run([ctr, "image", "inspect", image]).returncode == 0:
        return image
    ci = os.path.join(repo, "apps", "gtk", ".ci")
    dockerfile = os.path.join(ci, "Dockerfile")
    if not os.path.isfile(dockerfile):
        die("cannot build the Linux toolchain image: %s is missing" % dockerfile)
    print("[linux] %s: building the toolchain image %s (one-off, from the gate's "
          "apps/gtk/.ci/Dockerfile) ..." % (arch, image), flush=True)
    must([ctr, "build", "--platform", ARCH_PLATFORM[arch], "-t", image,
          "-f", dockerfile, ci], "toolchain image build for " + arch)
    return image


def merge_outputs(out, arts, version, notes):
    """Write SHA256SUMS + manifest.json covering EVERY artifact present in `out`.

    A --platform-scoped run must not erase the other platform's entries: the author will
    plausibly build the Mac artifacts on the Mac and the Linux ones in another run.
    Entries for files that no longer exist are dropped; same-named entries are
    replaced by this run's fresher data.
    """
    mpath = os.path.join(out, "manifest.json")
    merged = {}
    if os.path.isfile(mpath):
        try:
            with open(mpath) as fh:
                for a in json.load(fh).get("artifacts", []):
                    if os.path.isfile(os.path.join(out, a.get("file", ""))):
                        merged[a["file"]] = a
        except (ValueError, KeyError):
            notes.append("existing manifest.json was unreadable and was rebuilt")
    carried = [f for f in merged if f not in {a["file"] for a in arts}]
    for a in arts:
        merged[a["file"]] = a
    ordered = [merged[k] for k in sorted(merged)]

    # MIXED VERSIONS IN ONE OUTPUT DIRECTORY IS A PUBLISHING ACCIDENT WAITING TO
    # HAPPEN. Carrying the other platform's artifacts across runs is deliberate
    # (see the docstring) — carrying another VERSION's is not. When the version
    # moved 0.1 -> 0.1.0 (single-sourcing it in `5ac88d7`), this directory ended up
    # holding both, and SHA256SUMS listed all of them: uploading `dist/*` would
    # have published two different versions of the same app side by side, each with
    # a valid checksum. Refuse, loudly and non-destructively — deleting a built and
    # verified artifact is worse than stopping and saying which files to move.
    stale = sorted(a["file"] for a in ordered
                   if ("-%s-" % version) not in a["file"])
    if stale:
        die("refusing to write SHA256SUMS/manifest.json: %s holds artifacts from a "
            "different version than this run (%s).\n  offending: %s\nMove or delete "
            "them, or build into a clean directory with --out. Publishing a "
            "directory that mixes versions ships two apps at once."
            % (out, version, ", ".join(stale)))

    with open(os.path.join(out, "SHA256SUMS"), "w") as fh:
        for a in ordered:
            fh.write("%s  %s\n" % (a["sha256"], a["file"]))
    with open(mpath, "w") as fh:
        json.dump({"product": "less-sheet", "version": version,
                   "built_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                   "published": False, "artifacts": ordered, "notes": notes},
                  fh, indent=2)
        fh.write("\n")
    return ordered, carried


def build_linux(repo, out, version, arches, do_verify, notes):
    ctr = container_cmd()
    if not ctr:
        notes.append("Linux artifacts skipped: no podman/docker on this host")
        return []

    arts = []
    for arch in arches:
        image = ensure_build_image(ctr, repo, arch)
        print("[linux] %s: cross-building the ReleaseSafe core (glibc) ..." % arch, flush=True)
        work = tempfile.mkdtemp(prefix="ls-linux-%s-" % arch)
        try:
            prefix = os.path.join(work, "core")
            must(["zig", "build", "-Dtarget=" + ARCH_ZIG[arch],
                  "-Doptimize=ReleaseSafe", "--prefix", prefix],
                 "core cross-build for " + arch, cwd=os.path.join(repo, "backend"))
            core_a = os.path.join(prefix, "lib", "liblesssheet.a")
            if not os.path.isfile(core_a):
                die("core cross-built for %s but %s is missing" % (arch, core_a))

            # Stage the GTK sources OUT OF TREE so a release build never touches
            # apps/gtk/ (which would disturb the gate's working tree). Whole
            # directories, dereferencing symlinks: include/lesssheet.h is a
            # symlink to api/lesssheet.h, and src/ carries a private header.
            stage = os.path.join(work, "src")
            os.makedirs(os.path.join(stage, ".core-linux", "lib"))
            gtk = os.path.join(repo, "apps", "gtk")
            for sub in ("include", "src", "data", "tests"):
                shutil.copytree(os.path.join(gtk, sub), os.path.join(stage, sub),
                                symlinks=False)
            # Every TOP-LEVEL FILE, not a hand-listed pair. This staged only
            # meson.build, so when `apps/gtk/VERSION` appeared — a symlink to the
            # root VERSION, which meson reads as `project(version : files(...))`
            # — the release build died at configure time with "File VERSION does
            # not exist", while the gate stayed green because it builds in place
            # where the symlink resolves. A copy that takes a SUBSET of a
            # directory silently breaks the next file added to it; taking all of
            # them cannot. shutil.copy follows symlinks, so VERSION arrives as
            # content and does not need the tree above it.
            for entry in sorted(os.listdir(gtk)):
                src = os.path.join(gtk, entry)
                if os.path.isfile(src):
                    shutil.copy(src, os.path.join(stage, entry))
            shutil.copy(core_a, os.path.join(stage, ".core-linux", "lib"))

            # Pre-flight: the core archive must not leave compiler-rt helpers
            # UNRESOLVED, or the meson link fails with a wall of linker output that
            # looks like a frontend bug when it is really a core build-config issue.
            #
            # Concretely: on x86_64 the Zig backend emits calls to
            # `__zig_probe_stack` (stack probing). Until `1071708` the static
            # archive referenced it without defining it, so the GTK app could not be
            # linked with gcc/ld.bfd and x86_64 could not ship at all. aarch64 never
            # hit this — it emits no stack probes, so the symbol is neither
            # referenced nor needed. The Linux path verified in
            # ARCH-backend-linux-portability was musl + lld, which does not expose
            # it; we link glibc with gcc/ld.bfd. Fixed by `bundle_compiler_rt` for
            # x86 targets in backend/build.zig.
            #
            # UNDEFINED IS NOT THE TEST — DEFINED IS. The first version of this
            # check ran `nm --undefined-only | grep probe_stack` and skipped on any
            # hit, which reported x86_64 as still broken AFTER the fix landed and
            # would have kept it unbuildable indefinitely. An archive legitimately
            # carries BOTH an undefined reference (from the object that calls the
            # helper) and a weak definition (from the bundled `compiler_rt.o`) —
            # `nm` shows `U __zig_probe_stack` and `W __zig_probe_stack` side by
            # side, and the linker resolves them happily. So a symbol only counts as
            # missing when it is referenced AND defined NOWHERE in the archive:
            # compute the set difference rather than testing one half of it.
            probes = run([ctr, "run", "--rm", "--platform", ARCH_PLATFORM[arch],
                          "--security-opt", "label=disable", "-v", stage + ":/b:ro",
                          image, "sh", "-c",
                          "A=/b/.core-linux/lib/liblesssheet.a; echo __UNDEF__; "
                          "nm --undefined-only \"$A\" 2>/dev/null "
                          "| grep -o '__[a-z_]*probe_stack' | sort -u; echo __DEF__; "
                          "nm --defined-only \"$A\" 2>/dev/null "
                          "| grep -o '__[a-z_]*probe_stack' | sort -u"]).stdout
            undef, defined, bucket = set(), set(), None
            for tok in probes.split():
                if tok == "__UNDEF__":
                    bucket = undef
                elif tok == "__DEF__":
                    bucket = defined
                elif bucket is not None:
                    bucket.add(tok)
            missing = sorted(undef - defined)
            if missing:
                notes.append(
                    "Linux %s SKIPPED: the cross-built core archive references %s with no "
                    "definition anywhere in the archive, so the GTK app cannot be linked with "
                    "gcc/ld.bfd. aarch64 is unaffected (no stack probes emitted). This is what "
                    "`bundle_compiler_rt` in backend/build.zig exists to prevent — if it is "
                    "firing, that setting has regressed for this target."
                    % (arch, ", ".join(missing)))
                print("[linux] %s: SKIPPED - %s referenced but never defined (see notes)"
                      % (arch, ", ".join(missing)), flush=True)
                continue

            print("[linux] %s: building the app in %s ..." % (arch, image), flush=True)
            # --buildtype=release matters: meson's default is a -O0 -g debug build.
            # The gate only needs it to compile; a shipped binary needs optimisation.
            must([ctr, "run", "--rm", "--platform", ARCH_PLATFORM[arch],
                  "--security-opt", "label=disable", "-v", stage + ":/b", "-w", "/b",
                  image, "sh", "-euc",
                  # Do NOT silence meson/ninja here: they write compile errors to
                  # stdout, so redirecting it to /dev/null turns any build failure
                  # into a bare "exit 1" with no diagnostics to act on.
                  "meson setup build --buildtype=release && "
                  "meson compile -C build && strip build/less-sheet-gtk"],
                 "GTK build for " + arch)
            built = os.path.join(stage, "build", "less-sheet-gtk")
            if not os.path.isfile(built):
                die("GTK build for %s produced no binary" % arch)

            # Read the real runtime requirements off the ELF rather than assuming.
            probe = run([ctr, "run", "--rm", "--platform", ARCH_PLATFORM[arch],
                         "--security-opt", "label=disable", "-v", stage + ":/b",
                         image, "sh", "-euc",
                         "readelf -d /b/build/less-sheet-gtk | grep NEEDED; echo ---; "
                         "readelf -V /b/build/less-sheet-gtk | grep -o 'GLIBC_[0-9.]*' "
                         "| sort -uV | tail -1"]).stdout
            needed = re.findall(r"Shared library: \[([^\]]+)\]", probe)
            gl = re.findall(r"GLIBC_([0-9.]+)", probe)
            glibc = sorted(gl, key=lambda s: [int(x) for x in s.split(".")])[-1] if gl else "?"

            # Lay out the tarball payload.
            payload = os.path.join(work, "less-sheet")
            os.makedirs(payload)
            shutil.copy(built, os.path.join(payload, "less-sheet-gtk"))
            os.chmod(os.path.join(payload, "less-sheet-gtk"), 0o755)
            app_id = _gtk_app_id(gtk)
            shutil.copy(os.path.join(gtk, "data", app_id + ".svg"),
                        os.path.join(payload, app_id + ".svg"))
            with open(os.path.join(payload, app_id + ".desktop"), "w") as fh:
                fh.write(desktop_entry(repo, app_id))
            ish = os.path.join(payload, "install.sh")
            with open(ish, "w") as fh:
                fh.write(INSTALL_SH.replace("{app_id}", app_id))
            os.chmod(ish, 0o755)
            with open(os.path.join(payload, "README.txt"), "w") as fh:
                fh.write(README_LINUX.format(version=version, arch=arch, glibc=glibc))
            # The LGPL half of the compliance story: GTK stays dynamically
            # linked AND the notices travel with the binary (RELEASE.md 4a).
            for legal in LEGAL_FILES:
                shutil.copy(os.path.join(repo, legal), os.path.join(payload, legal))

            os.makedirs(out, exist_ok=True)
            tpath = os.path.join(out, "less-sheet-%s-linux-%s.tar.gz" % (version, arch))
            if os.path.exists(tpath):
                os.remove(tpath)
            # --no-xattrs + COPYFILE_DISABLE: macOS tar otherwise stores its own
            # xattrs (com.apple.provenance) in the archive, and GNU tar on the
            # user's Linux box then prints "Ignoring unknown extended header
            # keyword" once per file. Harmless, but it makes a first unpack look
            # like something went wrong.
            must(["tar", "--no-xattrs", "-C", work, "-czf", tpath, "less-sheet"], "tar",
                 env=dict(os.environ, COPYFILE_DISABLE="1"))

            ran = None
            if do_verify:
                ran = verify_linux_tarball(ctr, arch, tpath)
                print("[linux] %s: runs from the tarball in a clean runtime-only "
                      "container (%s)" % (arch, ran), flush=True)

            arts.append({
                "file": os.path.basename(tpath),
                "platform": "Linux",
                "arch": arch,
                "format": "tar.gz",
                "bytes": os.path.getsize(tpath),
                "sha256": sha256(tpath),
                "requires": {
                    "os": "Linux (glibc)",
                    "glibc": ">= " + glibc,
                    "gtk4": ">= 4.20",
                    "libadwaita": ">= 1.8",
                    "shared_libraries": needed,
                    "bundled_dependencies": "none - uses the system GNOME stack",
                    "known_good": "Fedora 43+, current Arch",
                    "known_bad": "Debian 13 trixie (GTK 4.18)",
                },
                "signing": {"state": "n/a on Linux"},
                # A TIMING FROM AN EMULATED CONTAINER IS NOT A PERFORMANCE NUMBER.
                # Building x86_64 on an ARM host runs every instruction through
                # QEMU, which inflated a measured cold start to ~1.9 s against
                # ~0.12 s for the native aarch64 artifact — a ~16x gap that says
                # nothing about x86_64 hardware and would badly misinform anyone
                # who found it later. `verified_by_running` exists to prove the
                # artifact EXECUTES on a machine that never built it, not to
                # measure speed, so the emulated case says so in the same string
                # rather than leaving a bare number to be misread. Real x86_64
                # figures need real x86_64 hardware.
                "verified_by_running": (
                    ran if HOST_ARCH_ALIASES.get(platform.machine(), platform.machine()) == arch
                    else ran + " -- EMULATED (%s host via QEMU): proves it RUNS, "
                                "NOT a performance measurement"
                                % platform.machine()),
            })
            # Bank each artifact as soon as it is verified. The x86_64 leg can take
            # hours when it has to run under emulation, and an abort part-way must
            # not lose an artifact that is already built and proven.
            merge_outputs(out, arts, version, notes)
        finally:
            shutil.rmtree(work, ignore_errors=True)
    return arts


def verify_linux_tarball(ctr, arch, tarball):
    """Unpack the tarball in a CLEAN fedora:43 container with only runtime deps.

    Deliberately uses the upstream base image, NOT the build image: it has no
    compiler, no -devel packages and no meson, so a success here proves the
    artifact runs on a machine that never built it. Xvfb and dbus are test
    scaffolding for a headless display, not app dependencies; GSK_RENDERER=cairo
    avoids needing a GPU, and GTK_A11Y=none avoids the absent a11y bus.
    """
    script = r"""
set -e
dnf -y install --setopt=install_weak_deps=False gtk4 libadwaita \
    xorg-x11-server-Xvfb dbus-daemon >/dev/null 2>&1
if command -v gcc >/dev/null 2>&1 || command -v meson >/dev/null 2>&1; then
    echo "VERIFY-FAIL: build tools present, this is not a clean runtime host" >&2
    exit 2
fi
mkdir -p /t && tar -C /t -xzf /art/app.tar.gz
printf 'id,name,city\n1,Ada,Riverside\n2,Alan,Fairview\n3,Grace,Madison\n' > /t/p.csv
ldd /t/less-sheet/less-sheet-gtk | grep 'not found' && {
    echo "VERIFY-FAIL: unresolved shared libraries" >&2; exit 3; }
export LESSSHEET_GTK_TIMING=1 GTK_A11Y=none GSK_RENDERER=cairo
# The app runs until its window closes, so `timeout` ending it is the expected
# outcome; the verdict is whether it reported a mapped window AND a filled one.
timeout 60 xvfb-run -a --server-args="-screen 0 1280x900x24" \
    /t/less-sheet/less-sheet-gtk /t/p.csv > /t/out.txt 2>&1 || true
cat /t/out.txt
"""
    art = tempfile.mkdtemp(prefix="ls-lxv-")
    try:
        shutil.copy(tarball, os.path.join(art, "app.tar.gz"))
        r = run([ctr, "run", "--rm", "--platform", ARCH_PLATFORM[arch],
                 "--security-opt", "label=disable", "-v", art + ":/art:ro",
                 RUNTIME_IMAGE, "sh", "-euc", script])
        blob = (r.stdout or "") + (r.stderr or "")
        if "VERIFY-FAIL" in blob:
            die("clean-container verification failed for %s:\n%s" % (arch, blob[-2000:]))
        cold = re.search(r"ui cold-start \(main -> window mapped\):\s*([0-9.]+) ms", blob)
        fill = re.search(r"window-fill \(open begin -> first frame\):\s*([0-9.]+) ms", blob)
        if not (cold and fill):
            die("the %s tarball did not open a window+file in a clean container:\n%s"
                % (arch, blob[-2000:]))
        return "cold-start %s ms, window-fill %s ms" % (cold.group(1), fill.group(1))
    finally:
        shutil.rmtree(art, ignore_errors=True)



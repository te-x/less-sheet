# The GTK app id the code already uses (data/dev.lesssheet.Gtk.svg + main.c's
# gtk_window_set_icon_name). docs/RELEASE.md flags the final Flatpak app-id as
# still-to-confirm, so this follows the code rather than inventing a new one.
# The GTK app id, read from the app's OWN single definition rather than copied.
# A copy here shipped the wrong value: after the rename to com.lesssheet.LessSheet
# (`5ac88d7`) this constant still said `dev.lesssheet.Gtk`, which would have put
# `Icon=dev.lesssheet.Gtk` in the installed .desktop file — pointing at an icon
# name the app no longer provides, so the launcher entry would render iconless on
# every Linux install. Nothing caught it: the app builds, the tarball builds, and
# desktop-file-validate checks SYNTAX, not whether the icon resolves.
def _gtk_app_id(gtk):
    """The single definition is `#define LSG_APP_ID "…"` in <gtk>/src/main.c."""
    src = os.path.join(gtk, "src", "main.c")
    with open(src) as fh:
        m = re.search(r'#define\s+LSG_APP_ID\s+"([^"]+)"', fh.read())
    if not m:
        die("cannot find `#define LSG_APP_ID` in %s — the release packaging reads "
            "the app id from the app itself and will not guess it" % src)
    return m.group(1)

# ONE desktop entry, at packaging/linux/, shared with the Flatpak manifest.
# It was a template string here, which would have forced the Flatpak to carry a
# second copy — and a drifting `Icon=` renders a launcher with no icon, no build
# error and nothing in any log. That exact bug already shipped once; see
# _gtk_app_id below.
DESKTOP_ENTRY_PATH = ("packaging", "linux", "com.lesssheet.LessSheet.desktop")


def desktop_entry(repo, app_id):
    """The committed .desktop, verified against the app's OWN id."""
    path = os.path.join(repo, *DESKTOP_ENTRY_PATH)
    if not os.path.isfile(path):
        die("%s is missing — it is the single definition of the desktop entry" % path)
    with open(path) as fh:
        body = fh.read()
    m = re.search(r"^Icon=(.*)$", body, re.M)
    found = m.group(1).strip() if m else "<no Icon= line>"
    if found != app_id:
        die("%s says Icon=%s but the app id is %s. The launcher would render "
            "iconless, and nothing else would complain." % (path, found, app_id))
    return body


#!/usr/bin/env python3
"""Deterministic screenshot capture for the less-sheet frontpage.

Produces the shot set `docs/architecture/ARCH-frontpage.md` §3.3 specifies, by
driving the app's OWN off-screen renderer rather than any screen-capture API.

WHY THERE IS NO SCREEN RECORDING PERMISSION HERE. `screencapture` is *screen*
recording and needs a TCC grant, which would put a system dialog in front of
whoever runs this. The app already renders itself: `FrameDump`
(apps/macos/Sources/LessSheetApp/FrameDump.swift) draws a scene OFF-SCREEN with
`ImageRenderer` when `LESSSHEET_DUMP_FRAME=<path>` is set, logs
`lesssheet.frame_dumped=<path>`, and needs no permission of any kind. So this
tool is fully unattended.

WHY THE DIMENSIONS ARE IDENTICAL BY CONSTRUCTION, WHICH IS THE POINT. §3.3
requires all variants of a shot to share exact pixel dimensions so the page's
platform toggle causes no layout shift; hand-matching that across a shot set
silently drifts. `FrameDump` renders a FIXED 900x600 layout at a FIXED
`renderer.scale = 2` => 1800x1200 px, independent of the display it runs on.
The post-check below still verifies it rather than trusting it, because a
requirement that is only satisfied by construction is one refactor away from
being satisfied by nothing.

WHAT THIS TOOL CANNOT DO, stated here rather than discovered later:
  * The `filter` shot has NO scene. FrameDump exposes grid / overlay / titlebar
    / overscroll / separator / quote / pills / jump / progress / settings /
    configure / reject and a find family (find, findtext, findwhere,
    findcounts, findnomatches, findwrapped, highlights) — nothing renders a
    FILTERED view with original row numbers kept. `findwhere` shows the typed
    predicate UI, which is the closest honest substitute, and is used here with
    that substitution named in the manifest. A real filter scene is a small
    addition to FrameDump and belongs to whoever next touches that file.
  * These are CONTENT renders, not window grabs: no window shadow, no rounded
    corners, no vibrancy / Liquid Glass behind the floating controls. That is a
    real fidelity trade for a permission-free, deterministic pipeline, and it is
    the author's call whether the page wants app-window chrome around them.
  * The hero "money shot" is a composition judgement. A script cannot make it.

AVIF comes from macOS's own `sips`, which lists `public.avif` as Writable — no
Homebrew encoder needed (`avifenc`, `magick` and `convert` are all absent here).
It matters: a render is ~280 KB as PNG against §3.3's 150 KB-per-shot budget, and
~65 KB as AVIF. PNG alone would have blown the page-weight budget by ~2x, so the
conversion is part of the tool rather than a follow-up someone forgets.

THE HERO HAS A DIFFERENT ASPECT RATIO ON PURPOSE. It is paged to row 1,048,576 —
which is EXACTLY Excel's row ceiling, so the shot shows the viewer sitting at the
row where Excel stops. That widens the row-number gutter and the layout with it
(1920x1240 vs 1800x1200 elsewhere). §3.3 requires identical dimensions ACROSS
VARIANTS OF ONE SHOT (so the platform toggle cannot shift layout) and one aspect
ratio across THE RAIL; the hero is band B1's own imagery, not part of the rail,
so its ratio is free. Both properties are checked below rather than assumed.

Usage:
    python3 tools/shots/capture_shots [--out DIR] [--app PATH] [--shots a,b]
"""

import argparse
import os
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))

# Platform is a page-level axis (ARCH §7.4 keeps a macOS/Linux toggle); this tool
# covers macOS. The Linux arm is the same driver with a GTK state mechanism and a
# different renderer, and is deliberately absent rather than stubbed: the author's
# Linux host was unreachable, and an unexercised path claims coverage it lacks.
PLATFORM = "macos"
THEMES = ("light", "dark")

# A ROW NUMBER BEYOND EXCEL'S CEILING WOULD BE THE BEST POSSIBLE HERO, AND THIS
# TOOL CANNOT PRODUCE ONE. Recording the two failed attempts because the next
# person will have the same idea:
#
#   1. `LESSSHEET_DUMP_FIRSTROW=1048576` against a 2,000-row fixture. The gutter
#      widened (silently changing the hero's dimensions to 1920x1240) but the
#      content clamped to row 1. The shot showed rows 1-26 while this file's own
#      comment claimed it sat at Excel's ceiling.
#   2. The same, against a 1,100,000-row fixture. STILL rows 1-26. FrameDump
#      fires just after first paint, when only the head of the file is indexed,
#      so `dumpMaterialize(startRow:)` has nothing to page to and clamps.
#
# Both were caught by CONVERTING THE AVIF AND LOOKING AT IT — every automated
# check passed both times, because dimension identity and aspect ratio are blind
# to which rows are on screen. A green post-check says nothing about content.
#
# Getting it would need FrameDump to wait for the index to reach the target row
# (or drive a jump first) before rendering — real work in apps/macos, not a knob.
# Until then the hero shows the top of a large file, and no claim is made about
# row numbers. Dropping the paging also removes the aspect-ratio exception it
# caused, so every shot is now 1800x1200 and the rail is uniform by default.
FIXTURE_ROWS = 2000

# shot -> (FrameDump scene, extra env, substitution note or None)
SHOTS = {
    "hero":    ("grid",      {},
                "the hero shows the TOP of the file: FrameDump cannot page to a "
                "high row number (see the note above the fixture constants), so "
                "no claim about row numbers can rest on this shot"),
    "jump":    ("jump",      {}, None),
    "dialect": ("separator", {}, None),
    "search":  ("findcounts", {}, None),
    "filter":  ("findwhere", {},
                "SUBSTITUTION: no filtered-view scene exists in FrameDump; "
                "`findwhere` shows the typed predicate instead of a filtered "
                "view with original row numbers kept"),
}

def die(msg):
    sys.stderr.write("error: %s\n" % msg)
    sys.exit(1)


def find_app(explicit):
    """The app BINARY (FrameDump runs inside the app, so we need the executable)."""
    if explicit:
        return explicit
    cands = [
        os.path.join(REPO, "apps", "macos", ".build", "arm64-apple-macosx",
                     "release", "LessSheet"),
        "/Applications/less-sheet.app/Contents/MacOS/LessSheet",
    ]
    for c in cands:
        if os.path.isfile(c) and os.access(c, os.X_OK):
            return c
    die("no app binary found. Build it (apps/macos/scripts/assemble-app.sh) or "
        "pass --app. Looked in:\n  " + "\n  ".join(cands))


def write_fixture(path, rows=FIXTURE_ROWS):
    """A deterministic fixture — same bytes every run, so shots are comparable.

    ARCH §7.7 names a csvgen-produced catalog file. This writes its own so the
    tool has no build-order dependency; swapping in `tools/csvgen` is a drop-in
    change if the richer corpus is wanted.

    Nine columns, not six: a 900 pt grid left three columns of dead space with
    six, and a hero shot with an empty right third undersells a viewer whose
    whole point is dense tabular data.
    """
    if os.path.isfile(path) and os.path.getsize(path) > 0:
        return path
    cities = ("Lisbon", "Berlin", "Porto", "Munich", "Faro")
    regions = ("EMEA", "APAC", "AMER")
    states = ("shipped", "pending", "packing", "held")
    with open(path, "w") as fh:
        fh.write("order_id,order_date,city,region,qty,unit_price,sku,status,notes\n")
        for i in range(rows):
            fh.write("%d,2026-%02d-%02d,%s,%s,%d,%.2f,%s,%s,%s\n" % (
                100000 + i,
                1 + (i % 12), 1 + (i % 28),
                cities[i % len(cities)],
                regions[i % len(regions)],
                1 + (i % 9),
                4.5 + (i % 37) * 0.25,
                "SKU-%05d" % (i * 7 % 99991),
                states[i % len(states)],
                "batch %d" % (i // 250),
            ))
    return path


def png_size(path):
    """(width, height) from the IHDR chunk — no image library needed."""
    with open(path, "rb") as fh:
        head = fh.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    return struct.unpack(">II", head[16:24])


# The rail shares one aspect ratio (§3.3); the hero is band B1's own imagery and
# not part of the rail, so it may differ.
#
# OBSERVED, CAUSE NOT ESTABLISHED: the bare `grid` scene renders 1920x1240 while
# every wrapped scene (jump / separator / findcounts / findwhere) renders
# 1800x1200, even though FrameDump passes the SAME `gridSize` (900x600) to
# `render` for all of them and the difference survives removing the row-paging
# and changing the column count. I guessed the cause three times — row paging,
# then column count, then scene padding — and was wrong each time, so this states
# the measurement and stops there rather than shipping a fourth guess as fact.
# It does not affect the page: the hero sits alone in its band.
RAIL_EXEMPT = ("hero",)
PER_SHOT_BUDGET_KB = 150


def to_avif(png):
    """PNG -> AVIF via macOS `sips`. Returns (path, kb) or (None, reason).

    §3.3 names `.avif` and sets a 150 KB per-shot budget; a render is ~280 KB as
    PNG and ~65 KB as AVIF, so this is what keeps the page inside its budget.
    Absolute paths only: `sips` reports a relative path it cannot resolve as
    "not a valid file - skipping" and still exits 0, which is a silent no-op.
    """
    avif = os.path.splitext(os.path.abspath(png))[0] + ".avif"
    if os.path.exists(avif):
        os.remove(avif)
    proc = subprocess.run(["sips", "-s", "format", "avif",
                           os.path.abspath(png), "--out", avif],
                          capture_output=True, text=True)
    if not os.path.isfile(avif):
        return None, ((proc.stderr or proc.stdout or "").strip().splitlines()
                      or ["sips produced no file"])[-1]
    return avif, os.path.getsize(avif) / 1024.0


def capture(app, fixture, shot, theme, out_dir, hero_fixture=None):
    scene, extra, _ = SHOTS[shot]
    if shot == "hero" and hero_fixture:
        fixture = hero_fixture
    out = os.path.join(out_dir, "shot-%s-%s-%s.png" % (shot, PLATFORM, theme))
    env = dict(os.environ)
    env.update({
        "LESSSHEET_DUMP_FRAME": out,
        "LESSSHEET_DUMP_SCENE": scene,
        "LESSSHEET_DUMP_APPEARANCE": theme,
        # Quit once the frame is written: this is a capture run, not a session.
        "LESSSHEET_DUMP_EXIT": "1",
    })
    env.update(extra)
    if os.path.exists(out):
        os.remove(out)

    t0 = time.time()
    proc = subprocess.run([app, fixture], env=env, capture_output=True,
                          text=True, timeout=120)
    blob = (proc.stdout or "") + (proc.stderr or "")
    # Gate on the app's OWN marker, never on a sleep: "the file appeared" can be
    # a half-written frame, whereas frame_dumped is logged after the write.
    ok = ("lesssheet.frame_dumped=" in blob) and os.path.isfile(out)
    return out, ok, time.time() - t0, blob


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=os.path.join(REPO, "site", "assets", "shots"))
    ap.add_argument("--app", default=None)
    ap.add_argument("--shots", default=",".join(SHOTS))
    ap.add_argument("--self-test-dimensions", action="store_true",
                    help="prove the post-check fails on a mismatched pair")
    args = ap.parse_args()

    if args.self_test_dimensions:
        return self_test()

    wanted = [s.strip() for s in args.shots.split(",") if s.strip()]
    for s in wanted:
        if s not in SHOTS:
            die("unknown shot %r (known: %s)" % (s, ", ".join(SHOTS)))

    app = find_app(args.app)
    os.makedirs(args.out, exist_ok=True)
    fixture = write_fixture(os.path.join(args.out, ".fixture-2000.csv"))
    hero_fixture = None

    print("capture_shots")
    print("  app     %s" % app)
    print("  fixture %s (%d rows, deterministic)" % (fixture, FIXTURE_ROWS))
    print("  out     %s" % args.out)
    print("  renders OFF-SCREEN via FrameDump — no screen-recording permission\n")

    produced, failed = {}, []
    for shot in wanted:
        for theme in THEMES:
            path, ok, secs, blob = capture(app, fixture, shot, theme, args.out,
                                           hero_fixture)
            if ok:
                sz = png_size(path)
                avif, kb = to_avif(path)
                if avif is None:
                    failed.append((shot, theme, ["AVIF conversion failed: %s" % kb]))
                    print("  %-8s %-5s  rendered, AVIF FAILED: %s" % (shot, theme, kb))
                    continue
                os.remove(path)          # the PNG is an intermediate, not an artifact
                produced.setdefault(shot, {})[theme] = (avif, sz, kb)
                over = " OVER BUDGET" if kb > PER_SHOT_BUDGET_KB else ""
                print("  %-8s %-5s  %s  %s  %5.0f KB%s  %.1fs"
                      % (shot, theme, os.path.basename(avif),
                         "%dx%d" % sz if sz else "?", kb, over, secs))
            else:
                failed.append((shot, theme, blob.strip().splitlines()[-3:]))
                print("  %-8s %-5s  FAILED (%.1fs)" % (shot, theme, secs))

    print("\n-- dimension post-check (the reason this tool exists) --")
    bad = 0
    for shot, variants in sorted(produced.items()):
        sizes = {t: s for t, (_p, s, _k) in variants.items()}
        uniq = set(sizes.values())
        if len(uniq) == 1:
            print("  %-8s OK   all %d variant(s) %s"
                  % (shot, len(sizes), "%dx%d" % uniq.pop()))
        else:
            bad += 1
            print("  %-8s MISMATCH  %s   <- the platform toggle WOULD shift layout"
                  % (shot, sizes))

    # The other half of §3.3, which the first version of this tool did not check:
    # one aspect ratio across the rail. Per-shot identity says nothing about it.
    print("\n-- rail aspect-ratio check (%s exempt: own band) --"
          % ", ".join(RAIL_EXEMPT))
    ratios = {}
    for shot, variants in sorted(produced.items()):
        if shot in RAIL_EXEMPT:
            continue
        for _t, (_p, s, _k) in variants.items():
            if s:
                ratios.setdefault(round(s[0] / s[1], 4), []).append(shot)
    if len(ratios) <= 1:
        print("  OK   rail shares one aspect ratio: %s"
              % (list(ratios)[0] if ratios else "n/a"))
    else:
        bad += 1
        print("  MISMATCH  %s" % {r: sorted(set(v)) for r, v in ratios.items()})
    for shot in RAIL_EXEMPT:
        if shot in produced:
            _p, s, _k = next(iter(produced[shot].values()))
            print("  note %s is %dx%d (ratio %.4f) — the bare `grid` scene renders "
                  "larger than the wrapped scenes; cause not established, and it "
                  "does not matter because the hero sits alone in its band"
                  % (shot, s[0], s[1], s[0] / s[1]))

    total_kb = sum(k for v in produced.values() for (_p, _s, k) in v.values())
    print("\n  total %d file(s), %.0f KB (one theme's worth is what a visitor "
          "loads: %.0f KB)" % (sum(len(v) for v in produced.values()), total_kb,
                               total_kb / max(1, len(THEMES))))

    print("\n-- what still needs a human --")
    print("  * the hero composition is a judgement a script cannot make")
    print("  * review every output before it ships (ARCH AC-13)")
    print("  * these are CONTENT renders: no window shadow/rounded corners/vibrancy")
    for shot, (_s, _e, note) in SHOTS.items():
        if note and shot in produced:
            print("  * %s: %s" % (shot, note))
    print("  * Linux variants are NOT produced by this tool (macOS only)")

    if failed:
        print("\n-- failures --")
        for shot, theme, tail in failed:
            print("  %s/%s:" % (shot, theme))
            for line in tail:
                print("      %s" % line)

    if bad or failed:
        sys.exit(1)


def self_test():
    """Prove the dimension check has teeth, per the coordinator's requirement.

    A post-check that has never rejected anything is indistinguishable from one
    that cannot.
    """
    import tempfile
    d = tempfile.mkdtemp()

    def fake_png(path, w, h):
        ihdr = struct.pack(">II", w, h)
        with open(path, "wb") as fh:
            fh.write(b"\x89PNG\r\n\x1a\n" + b"\x00" * 8 + ihdr)

    a = os.path.join(d, "a.png")
    b = os.path.join(d, "b.png")
    fake_png(a, 1800, 1200)
    fake_png(b, 1800, 1199)
    sa, sb = png_size(a), png_size(b)
    print("self-test: %s vs %s -> %s"
          % (sa, sb, "DETECTED (correct)" if sa != sb else "MISSED (broken)"))
    same = os.path.join(d, "c.png")
    fake_png(same, 1800, 1200)
    print("self-test: identical pair -> %s"
          % ("accepted (correct)" if png_size(a) == png_size(same) else "false alarm"))
    sys.exit(0 if sa != sb and png_size(a) == png_size(same) else 1)


if __name__ == "__main__":
    main()

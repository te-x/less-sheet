#!/usr/bin/env python3
"""Deterministic screenshot capture for the less-sheet frontpage.

Two capture modes, and the difference is the whole history of this tool:

  window (default)  Photographs the REAL window with `screencapture -l`:
      traffic lights, transparent title bar, rounded corners, shadow, and the
      macOS 26 glass/scroll-edge materials. This is what ships. It requires the
      one-time Screen Recording permission for the app running this tool —
      checked with a preflight that NEVER pops the system dialog; if the grant
      is missing the tool prints the exact click and stops.

  flat              The app's own off-screen content render (`FrameDump`,
      LESSSHEET_DUMP_FRAME). No permission needed, fully headless — and
      REJECTED by the author for the page ("no window borders, traffic lights,
      the transparent/glass effects are gone"). Kept because it needs no
      display and no grant: useful for layout smoke tests, never for shipping.

Determinism, both modes: a fixed deterministic fixture, app state driven
through the SAME probe entry points the verification suite uses (a real find,
a real jump, a real filter — no synthetic input events), theme pinned
per-process (LESSSHEET_CAPTURE_APPEARANCE / LESSSHEET_DUMP_APPEARANCE; the
system setting is never touched), and in window mode a fixed content size
(LESSSHEET_CAPTURE_SIZE) so the autosaved window frame cannot leak geometry
between runs. A post-check asserts all variants of each shot are
pixel-identical — that requirement is the reason this tool exists.

Honest residuals the tool prints at the end: the hero composition is a human
judgement, every output needs the author's review before it ships (ARCH AC-13),
and the Linux arm is deliberately absent rather than stubbed.

Usage:
    python3 tools/shots/capture_shots [--mode window|flat] [--out DIR]
        [--app PATH] [--shots a,b] [--self-test-dimensions]
"""

import argparse
import functools
import os
import re
import shutil
import struct
import subprocess
import sys
import tempfile
import time

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(os.path.dirname(HERE))

PLATFORM = "macos"
THEMES = ("light", "dark")
FIXTURE_ROWS = 2000

# Window-mode content size in points (Retina renders at 2x). Fixed so every
# variant of every shot shares one geometry; the window's autosaved frame is
# overridden for the capture process only (CaptureProbe), never persisted.
WINDOW_SIZE = "1240x780"

# shot -> (state env, settle regex, note-or-None)
#
# State env drives the app's real probe entry points; the settle regex is the
# app's OWN stdout/stderr marker that the state has finished landing — never a
# bare sleep, so a half-painted or mid-scan window cannot be captured. Every
# shot also implicitly waits for `lesssheet.capture_window=<id>` (the window id
# `screencapture -l` takes, printed by CaptureProbe after first paint).
SHOTS = {
    "hero": ({}, r"first_rows_visible_ms", None),
    # Gate on the REOPEN, not the landing: landing dismisses the jump field, so
    # a shot taken at `jump.landed` is a grid parked at row 1500 with no control
    # visible — indistinguishable from the hero, which is what first shipped.
    "jump": ({"LESSSHEET_JUMP": "1500", "LESSSHEET_CAPTURE_REVEAL": "jump"},
             r"lesssheet\.capture_jump_reopened=", None),
    "dialect": ({"LESSSHEET_CAPTURE_REVEAL": "separator"}, r"first_rows_visible_ms",
                None),
    "search": ({"LESSSHEET_FIND": "Lisbon"}, r"lesssheet\.find\.count_final", None),
    # `.done` is the probe's FINAL marker. The first run keyed on any
    # filterrepaint line and captured mid-rematerialize: a dark window with a
    # perfect popover, a correct "Filtered - 400 of 2.0K rows" pill, correct
    # filtered gutter numbers - and NO CELL TEXT. Only looking at the image
    # caught it; the light variant of the same run happened to win the race.
    "filter": ({"LESSSHEET_FILTER_REPAINT": "Lisbon"}, r"lesssheet\.filterrepaint\.done",
               None),
}

# Flat mode renders FrameDump scenes instead (kept for headless smoke tests).
FLAT_SCENES = {
    "hero": ("grid", {}),
    "jump": ("jump", {}),
    "dialect": ("separator", {}),
    "search": ("findcounts", {}),
    "filter": ("findwhere", {}),
}

SETTLE_SECONDS = 1.2       # after the state marker: animations/glass settle
LAUNCH_DEADLINE = 40       # per variant, before the launch is declared failed
PER_SHOT_BUDGET_KB = 150   # ARCH-frontpage §3.3


print = functools.partial(print, flush=True)   # a hang must not look silent


def die(msg):
    sys.stderr.write("error: %s\n" % msg)
    sys.exit(1)


def find_app(explicit):
    """The freshly built binary — and NEVER a silent fallback to an older one.

    This cost a 400-second dead run. `apps/macos/.aidev/profile.sh`'s conformance
    step does `rm -rf .build/*/release/LessSheet` before rebuilding, so ANY gate
    run can leave that path missing for a while. The first version of this
    function then fell back to /Applications/less-sheet.app — an installed copy
    from two days earlier that predates CaptureProbe, so no capture_window marker
    ever arrived and all ten variants burned their 40 s deadline in silence.
    Same family as the stale-bundle traps already recorded for this app: a
    verified-looking run against the wrong binary.

    So: build path only (or --app), and the binary must actually CONTAIN the
    capture affordance. Refuse loudly instead of guessing."""
    build = os.path.join(REPO, "apps", "macos", ".build", "arm64-apple-macosx",
                         "release", "LessSheet")
    app = explicit or build
    if not (os.path.isfile(app) and os.access(app, os.X_OK)):
        die("no app binary at %s\n"
            "  (a gate run deletes it before rebuilding, so this is normal after one)\n"
            "  build it:  cd apps/macos && swift build -c release\n"
            "  or pass --app <path> — but NOT an installed .app unless it is fresh"
            % app)
    # Capability check, not a version guess: the marker string must be in the
    # binary. Without it the run cannot possibly succeed.
    try:
        with open(app, "rb") as fh:
            blob = fh.read()
    except OSError as e:
        die("cannot read %s: %s" % (app, e))
    if b"lesssheet.capture_window=" not in blob:
        die("%s predates the capture affordance (no capture_window marker).\n"
            "  rebuild:  cd apps/macos && swift build -c release" % app)
    return app


def write_fixture(path, rows=FIXTURE_ROWS):
    """Deterministic fixture — same bytes every run, so shots are comparable."""
    if os.path.isfile(path) and os.path.getsize(path) > 0:
        return path
    cities = ("Lisbon", "Berlin", "Porto", "Munich", "Faro")
    regions = ("EMEA", "APAC", "AMER")
    states = ("shipped", "pending", "packing", "held")
    with open(path, "w") as fh:
        fh.write("order_id,order_date,city,region,qty,unit_price,sku,status,notes\n")
        for i in range(rows):
            fh.write("%d,2026-%02d-%02d,%s,%s,%d,%.2f,%s,%s,%s\n" % (
                100000 + i, 1 + (i % 12), 1 + (i % 28),
                cities[i % len(cities)], regions[i % len(regions)],
                1 + (i % 9), 4.5 + (i % 37) * 0.25,
                "SKU-%05d" % (i * 7 % 99991), states[i % len(states)],
                "batch %d" % (i // 250)))
    return path


def png_size(path):
    with open(path, "rb") as fh:
        head = fh.read(24)
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        return None
    return struct.unpack(">II", head[16:24])


# Tuned against REAL captures, not a resampled sample: a first pass measured q82
# on a PNG that had already been through AVIF, so it reported ~137 KB and the
# real sources then landed 159-175 KB — over budget. q76 at 1500 px measures
# 133-144 KB on the true sources. Resolution was the honest lever, quality
# second.
WEBP_QUALITY = "76"
# Captures are 2704 px wide (1240 pt content + shadow at 2x) but display at
# ~600 CSS px, so 1500 px keeps >2.4x oversampling for retina while roughly
# halving the encoded bytes. Applied to the PNG before encoding; the
# dimension post-check runs on the resized output, so identity still holds.
RESIZE_MAX_PX = "1500"


def to_webp(png):
    """PNG -> WebP via cwebp (alpha preserved for the window shadow).

    WHY NOT AVIF: the first shipping set was AVIF from macOS `sips`, and
    the author found the pages images blank in Firefox — Apple's encoder emits
    the progressive/layered flavor (brand `MiPr`) that Firefox's decoder
    does not render, while Safari shows it fine. WebP decodes everywhere
    this page supports, carries alpha, and cwebp is purpose-built for it.
    (cwebp arrives via `brew install webp`; if it dies loading libtiff, a
    stale brew state is missing its declared dependency — `brew install
    libtiff` repairs it. Both happened on the machine this was built on.)"""
    if not shutil.which("cwebp"):
        die("cwebp not found - `brew install webp` (and `brew install libtiff` "
            "if cwebp dies at launch missing libtiff.6.dylib)")
    webp = os.path.splitext(os.path.abspath(png))[0] + ".webp"
    if os.path.exists(webp):
        os.remove(webp)
    subprocess.run(["sips", "-Z", RESIZE_MAX_PX, os.path.abspath(png)],
                   capture_output=True, text=True)
    proc = subprocess.run(["cwebp", "-quiet", "-q", WEBP_QUALITY,
                           "-alpha_q", "100", os.path.abspath(png), "-o", webp],
                          capture_output=True, text=True)
    if not os.path.isfile(webp):
        return None, ((proc.stderr or proc.stdout or "").strip().splitlines()
                      or ["cwebp produced no file"])[-1]
    return webp, os.path.getsize(webp) / 1024.0


# ---------------------------------------------------------------------------
# Window mode
# ---------------------------------------------------------------------------

def tcc_granted():
    """Compile-and-run the query-only preflight. Never pops the dialog."""
    if not shutil.which("swiftc"):
        die("swiftc not found — needed once to build the TCC preflight helper "
            "(xcode-select --install)")
    d = tempfile.mkdtemp(prefix="lsshots-")
    helper = os.path.join(d, "tccpreflight")
    src = os.path.join(HERE, "tccpreflight.swift")
    r = subprocess.run(["swiftc", "-O", src, "-o", helper],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die("could not build the TCC preflight helper:\n" + r.stderr)
    return subprocess.run([helper]).returncode == 0


GRANT_INSTRUCTIONS = """\
Screen Recording permission is NOT granted to the app running this tool, and
this tool never pops the permission dialog itself.

One-time grant (the author):
  1. System Settings -> Privacy & Security -> Screen Recording
  2. Enable it for the application this tool runs inside
     (Terminal / iTerm2 / the IDE hosting the shell)
  3. macOS will ask to quit & reopen that application - do it
  4. Re-run:  python3 tools/shots/capture_shots

Nothing was captured. No dialog was triggered.\
"""


def capture_window(app, fixture, shot, theme, out_dir):
    state_env, settle_re, _ = SHOTS[shot]
    out_png = os.path.join(out_dir, "shot-%s-%s-%s.png" % (shot, PLATFORM, theme))
    env = dict(os.environ)
    env.update(state_env)
    env.update({
        "LESSSHEET_CAPTURE_SIZE": WINDOW_SIZE,
        "LESSSHEET_CAPTURE_APPEARANCE": theme,
        # NO LESSSHEET_DUMP_EXIT: the window must stay alive to be photographed.
    })
    if os.path.exists(out_png):
        os.remove(out_png)

    t0 = time.time()
    proc = subprocess.Popen([app, fixture], env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                            text=True, bufsize=1)
    win_id, settled, tail = None, False, []
    try:
        deadline = t0 + LAUNCH_DEADLINE
        for line in proc.stdout:
            tail = (tail + [line.rstrip()])[-6:]
            m = re.search(r"lesssheet\.capture_window=(-?\d+)", line)
            if m:
                win_id = int(m.group(1))
            if re.search(settle_re, line):
                settled = True
            if win_id is not None and settled:
                break
            if time.time() > deadline:
                break
        if win_id is None or win_id < 0 or not settled:
            return out_png, False, time.time() - t0, tail + [
                "no capture_window/settle marker (win_id=%r settled=%r)"
                % (win_id, settled)]
        time.sleep(SETTLE_SECONDS)
        # -x: no sound. Window capture includes chrome, corners and shadow.
        shot_r = subprocess.run(["screencapture", "-x", "-l", str(win_id), out_png],
                                capture_output=True, text=True)
        ok = shot_r.returncode == 0 and os.path.isfile(out_png) \
            and os.path.getsize(out_png) > 0
        if not ok:
            tail.append("screencapture rc=%d %s"
                        % (shot_r.returncode, (shot_r.stderr or "").strip()))
        return out_png, ok, time.time() - t0, tail
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()


def capture_flat(app, fixture, shot, theme, out_dir):
    scene, extra = FLAT_SCENES[shot]
    out = os.path.join(out_dir, "shot-%s-%s-%s.png" % (shot, PLATFORM, theme))
    env = dict(os.environ)
    env.update({"LESSSHEET_DUMP_FRAME": out, "LESSSHEET_DUMP_SCENE": scene,
                "LESSSHEET_DUMP_APPEARANCE": theme, "LESSSHEET_DUMP_EXIT": "1"})
    env.update(extra)
    if os.path.exists(out):
        os.remove(out)
    t0 = time.time()
    proc = subprocess.run([app, fixture], env=env, capture_output=True,
                          text=True, timeout=120)
    blob = (proc.stdout or "") + (proc.stderr or "")
    ok = ("lesssheet.frame_dumped=" in blob) and os.path.isfile(out)
    return out, ok, time.time() - t0, blob.strip().splitlines()[-3:]


# ---------------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--mode", choices=("window", "flat"), default="window")
    ap.add_argument("--out", default=os.path.join(REPO, "site", "assets", "shots"))
    ap.add_argument("--app", default=None)
    ap.add_argument("--shots", default=",".join(SHOTS))
    ap.add_argument("--self-test-dimensions", action="store_true",
                    help="prove the post-check fails on a mismatched pair")
    args = ap.parse_args()

    if args.self_test_dimensions:
        return self_test()

    wanted = [s.strip() for s in args.shots.split(",") if s.strip()]
    for s in wanted:
        if s not in SHOTS:
            die("unknown shot %r (known: %s)" % (s, ", ".join(SHOTS)))

    if args.mode == "window" and not tcc_granted():
        print(GRANT_INSTRUCTIONS)
        sys.exit(2)

    app = find_app(args.app)
    os.makedirs(args.out, exist_ok=True)
    fixture = write_fixture(os.path.join(args.out, ".fixture-2000.csv"))

    print("capture_shots (%s mode)" % args.mode)
    print("  app     %s" % app)
    print("  fixture %s (%d rows, deterministic)" % (fixture, FIXTURE_ROWS))
    print("  out     %s" % args.out)
    if args.mode == "window":
        print("  window  %s pt content, real chrome via screencapture -l" % WINDOW_SIZE)
        print("  note    windows will appear on screen while this runs\n")
    else:
        print("  renders OFF-SCREEN via FrameDump — layout smoke test only,\n"
              "          NOT the shipping look (no chrome, no glass)\n")

    cap = capture_window if args.mode == "window" else capture_flat
    produced, failed = {}, []
    for shot in wanted:
        for theme in THEMES:
            path, ok, secs, tail = cap(app, fixture, shot, theme, args.out)
            if not ok:
                failed.append((shot, theme, tail))
                print("  %-8s %-5s  FAILED (%.1fs)" % (shot, theme, secs))
                continue
            webp, kb = to_webp(path)   # resizes the PNG in place first
            sz = png_size(path)        # so the recorded size is what ships
            if webp is None:
                failed.append((shot, theme, ["WebP conversion failed: %s" % kb]))
                print("  %-8s %-5s  rendered, WebP FAILED: %s" % (shot, theme, kb))
                continue
            os.remove(path)
            produced.setdefault(shot, {})[theme] = (webp, sz, kb)
            over = "  OVER BUDGET" if kb > PER_SHOT_BUDGET_KB else ""
            print("  %-8s %-5s  %s  %s  %5.0f KB%s  %.1fs"
                  % (shot, theme, os.path.basename(webp),
                     "%dx%d" % sz if sz else "?", kb, over, secs))

    print("\n-- dimension post-check (the reason this tool exists) --")
    bad = 0
    for shot, variants in sorted(produced.items()):
        sizes = {t: s for t, (_p, s, _k) in variants.items()}
        uniq = set(sizes.values())
        if len(uniq) == 1:
            print("  %-8s OK   all %d variant(s) %s"
                  % (shot, len(sizes), "%dx%d" % uniq.pop()))
        else:
            bad += 1
            print("  %-8s MISMATCH  %s   <- the platform toggle WOULD shift layout"
                  % (shot, sizes))

    ratios = {}
    for shot, variants in sorted(produced.items()):
        for _t, (_p, s, _k) in variants.items():
            if s:
                ratios.setdefault(round(s[0] / s[1], 4), []).append(shot)
    if len(ratios) > 1:
        # Window mode should give ONE geometry everywhere (same window size);
        # a split here means a shot changed the window — say so, loudly.
        bad += 1
        print("  aspect MISMATCH across shots: %s"
              % {r: sorted(set(v)) for r, v in ratios.items()})

    total_kb = sum(k for v in produced.values() for (_p, _s, k) in v.values())
    print("\n  total %d file(s), %.0f KB (a visitor loads one theme: ~%.0f KB)"
          % (sum(len(v) for v in produced.values()), total_kb,
             total_kb / max(1, len(THEMES))))

    print("\n-- what still needs a human --")
    print("  * the hero composition is a judgement a script cannot make")
    print("  * review every output before it ships (ARCH AC-13)")
    for shot, (_e, _r, note) in SHOTS.items():
        if note and shot in produced:
            print("  * %s: %s" % (shot, note))
    print("  * Linux variants are NOT produced by this tool (macOS only)")

    if failed:
        print("\n-- failures --")
        for shot, theme, tail in failed:
            print("  %s/%s:" % (shot, theme))
            for line in tail:
                print("      %s" % line)

    if bad or failed:
        sys.exit(1)


def self_test():
    """A post-check that has never rejected anything is indistinguishable from
    one that cannot; prove it can."""
    d = tempfile.mkdtemp()

    def fake_png(path, w, h):
        with open(path, "wb") as fh:
            fh.write(b"\x89PNG\r\n\x1a\n" + b"\x00" * 8 + struct.pack(">II", w, h))

    a, b, c = (os.path.join(d, n) for n in ("a.png", "b.png", "c.png"))
    fake_png(a, 2480, 1560)
    fake_png(b, 2480, 1559)
    fake_png(c, 2480, 1560)
    mismatch = png_size(a) != png_size(b)
    match = png_size(a) == png_size(c)
    print("self-test: mismatched pair -> %s"
          % ("DETECTED (correct)" if mismatch else "MISSED (broken)"))
    print("self-test: identical pair  -> %s"
          % ("accepted (correct)" if match else "false alarm"))
    sys.exit(0 if mismatch and match else 1)


if __name__ == "__main__":
    main()

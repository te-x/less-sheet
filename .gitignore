.DS_Store
zig-out/
.zig-cache/
zig-cache/
.build/
DerivedData/
xcuserdata/
*.o
*.a

# Generated icon artifacts (source of truth: branding/icon.svg)
branding/generated/
__pycache__/

# Benchmark reports: less_sheet_bench.py writes bench-<host>-<ts>.txt into the
# directory under test, so they land wherever a run happens. Results worth keeping
# get summarised into review/ or the ARCH, not committed raw.
bench-*.txt

# Release artifacts built by tools/release/make_release (.dmg/.zip/.tar.gz +
# SHA256SUMS + manifest.json). Reproducible from a tag, so never committed; the
# checksums that matter get published alongside the download links.
dist/

# Screenshot capture fixtures (deterministic, regenerated by tools/shots/capture_shots)
site/assets/shots/.fixture-*.csv
